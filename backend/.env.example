# --- Supabase Postgres ---
# In Supabase: Project Settings -> Database -> Connection string
# Use the "Transaction" pooler string (port 6543) for DATABASE_URL,
# and the direct connection string (port 5432) for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# --- Admin account (created when you run `npm run seed`) ---
# Log in with these at /login, then you'll be sent to /admin. Change the password!
ADMIN_EMAIL="admin@jiggyathletic.club"
ADMIN_PASSWORD="ChangeThisPassword123"
